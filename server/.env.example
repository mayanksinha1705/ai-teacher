# Ollama server (must already be running locally: `ollama serve`)
OLLAMA_URL=http://localhost:11434

# Model to use for all lesson generation, evaluation and assessment.
# Must already be pulled/available: `ollama pull gpt-oss:120b-cloud`
OLLAMA_MODEL=gpt-oss:120b-cloud

# Port the AI Teacher backend listens on
PORT=8787
